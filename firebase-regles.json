{
  "rules": {
    "scores": {
      "$jeu": {
        ".read": "$jeu.matches(/^(blocs|labyrinthe|blindtest|demineur_facile|demineur_moyen|demineur_expert)$/)",
        ".indexOn": [
          "s",
          "t"
        ],
        "$id": {
          ".write": "$jeu.matches(/^(blocs|labyrinthe|blindtest|demineur_facile|demineur_moyen|demineur_expert)$/) && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['n', 'd']) && ($jeu.beginsWith('demineur_') ? newData.hasChildren(['t']) : newData.hasChildren(['s', 'lv']))",
          "n": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
          },
          "d": {
            ".validate": "newData.val() == now"
          },
          "s": {
            ".validate": "!$jeu.beginsWith('demineur_') && newData.isNumber() && newData.val() > 0 && newData.val() <= 10000000"
          },
          "lv": {
            ".validate": "!$jeu.beginsWith('demineur_') && newData.isNumber() && newData.val() >= 1 && newData.val() <= 999"
          },
          "t": {
            ".validate": "$jeu.beginsWith('demineur_') && newData.isNumber() && newData.val() >= 1000 && newData.val() <= 3600000"
          },
          "$autre": {
            ".validate": false
          }
        }
      }
    },
    "series": {
      "$jeu": {
        ".read": "$jeu.matches(/^(wordle|loldle|paysdle|connexions|onepiecedle)$/)",
        ".indexOn": [
          "s",
          "b"
        ],
        "$id": {
          ".write": "$jeu.matches(/^(wordle|loldle|paysdle|connexions|onepiecedle)$/) && $id.matches(/^[a-z0-9]{20}$/) && newData.exists()",
          ".validate": "newData.hasChildren(['n', 's', 'b', 'j', 'd']) && newData.child('s').val() <= newData.child('j').val() + 1 && newData.child('b').val() >= newData.child('s').val() && newData.child('b').val() <= newData.child('j').val() + 1 && (!data.exists() || (newData.child('j').val() == data.child('j').val() && newData.child('s').val() <= data.child('s').val() && newData.child('b').val() <= data.child('b').val()) || (newData.child('j').val() == data.child('j').val() + 1 && newData.child('s').val() <= data.child('s').val() + 1 && (newData.child('b').val() <= data.child('b').val() || newData.child('b').val() == newData.child('s').val())) || (newData.child('j').val() > data.child('j').val() + 1 && newData.child('s').val() <= 1 && (newData.child('b').val() <= data.child('b').val() || newData.child('b').val() == newData.child('s').val())))",
          "n": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
          },
          "s": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "b": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "j": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && now >= 1793491200000 + newData.val() * 86400000 - 10800000 && now <= 1793491200000 + (newData.val() + 1) * 86400000"
          },
          "d": {
            ".validate": "newData.val() == now"
          },
          "$autre": {
            ".validate": false
          }
        }
      }
    },
    "resultats": {
      "$jeu": {
        ".read": "$jeu.matches(/^(wordle|loldle|paysdle|connexions|onepiecedle)$/)",
        ".indexOn": [
          "j"
        ],
        "$id": {
          ".write": "$jeu.matches(/^(wordle|loldle|paysdle|connexions|onepiecedle)$/) && $id.matches(/^[a-z0-9]{20}$/) && newData.exists() && (!data.exists() || newData.child('j').val() > data.child('j').val())",
          ".validate": "newData.hasChildren(['j', 'e', 'g', 'd'])",
          "j": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && now >= 1793491200000 + newData.val() * 86400000 - 10800000 && now <= 1793491200000 + (newData.val() + 1) * 86400000"
          },
          "e": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500"
          },
          "g": {
            ".validate": "newData.isBoolean()"
          },
          "d": {
            ".validate": "newData.val() == now"
          },
          "$autre": {
            ".validate": false
          }
        }
      }
    }
  }
}
