{
  "rules": {
    "scores": {
      "$jeu": {
        ".read": "$jeu.matches(/^(blocs|labyrinthe|blindtest|geoguessr|demineur_facile|demineur_moyen|demineur_expert|coupdefeu|coupdefeu_plat|defense)$/)",
        ".indexOn": [
          "s",
          "t",
          "k",
          "d"
        ],
        "$id": {
          ".write": "$jeu.matches(/^(blocs|labyrinthe|blindtest|geoguessr|demineur_facile|demineur_moyen|demineur_expert|coupdefeu|coupdefeu_plat|defense)$/) && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['n', 'd']) && ($jeu.beginsWith('demineur_') ? newData.hasChildren(['t']) : $jeu === 'coupdefeu' ? newData.hasChildren(['s', 'lv', 'k']) : newData.hasChildren(['s', 'lv']))",
          "n": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
          },
          "d": {
            ".validate": "newData.val() == now"
          },
          "s": {
            ".validate": "!$jeu.beginsWith('demineur_') && newData.isNumber() && newData.val() > 0 && newData.val() <= ($jeu.beginsWith('coupdefeu') ? 1000000000000000 : 10000000)"
          },
          "lv": {
            ".validate": "!$jeu.beginsWith('demineur_') && newData.isNumber() && newData.val() >= 1 && newData.val() <= 999"
          },
          "t": {
            ".validate": "$jeu.beginsWith('demineur_') && newData.isNumber() && newData.val() >= 1000 && newData.val() <= 3600000"
          },
          "k": {
            ".validate": "$jeu === 'coupdefeu' && newData.isNumber() && newData.val() >= newData.parent().child('lv').val() * 1000000000 && newData.val() < (newData.parent().child('lv').val() + 1) * 1000000000"
          },
          "r": {
            ".validate": "$jeu === 'coupdefeu_plat' && newData.isString() && newData.val().length <= 20"
          },
          "$autre": {
            ".validate": false
          }
        }
      }
    },
    "series": {
      "$jeu": {
        ".read": "$jeu.matches(/^(wordle|loldle|paysdle|connexions|onepiecedle|pokedle|anidle|sudoku)$/)",
        ".indexOn": [
          "s",
          "b"
        ],
        "$id": {
          ".write": "$jeu.matches(/^(wordle|loldle|paysdle|connexions|onepiecedle|pokedle|anidle|sudoku)$/) && $id.matches(/^[a-z0-9]{20}$/) && newData.exists()",
          ".validate": "newData.hasChildren(['n', 's', 'b', 'j', 'd']) && newData.child('s').val() <= newData.child('j').val() + 1 && newData.child('b').val() >= newData.child('s').val() && newData.child('b').val() <= newData.child('j').val() + 1 && (!data.exists() || (newData.child('j').val() == data.child('j').val() && newData.child('s').val() <= data.child('s').val() && newData.child('b').val() <= data.child('b').val()) || (newData.child('j').val() == data.child('j').val() + 1 && newData.child('s').val() <= data.child('s').val() + 1 && (newData.child('b').val() <= data.child('b').val() || newData.child('b').val() == newData.child('s').val())) || (newData.child('j').val() > data.child('j').val() + 1 && newData.child('s').val() <= 1 && (newData.child('b').val() <= data.child('b').val() || newData.child('b').val() == newData.child('s').val())))",
          "n": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
          },
          "s": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "b": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "j": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && now >= 1793491200000 + newData.val() * 86400000 - 10800000 && now <= 1793491200000 + (newData.val() + 1) * 86400000"
          },
          "d": {
            ".validate": "newData.val() == now"
          },
          "$autre": {
            ".validate": false
          }
        }
      }
    },
    "eveil": {
      ".read": true,
      ".indexOn": [
        "p",
        "t",
        "r"
      ],
      "$id": {
        ".write": "$id.matches(/^[a-z0-9]{20}$/) && newData.exists()",
        ".validate": "newData.hasChildren(['n', 'p', 't', 'r', 'dr', 'd']) && (!data.exists() || (newData.child('p').val() >= data.child('p').val() && newData.child('t').val() >= data.child('t').val() && newData.child('r').val() >= data.child('r').val()))",
        "n": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
        },
        "p": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "t": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "r": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9"
        },
        "dr": {
          ".validate": "(!data.exists() || newData.parent().child('r').val() > data.parent().child('r').val()) ? newData.val() == now : newData.val() == data.val()"
        },
        "d": {
          ".validate": "newData.val() == now"
        },
        "$autre": {
          ".validate": false
        }
      }
    },
    "blackjack": {
      ".read": true,
      ".indexOn": [
        "s"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren(['n', 's', 'j', 'm', 'd'])",
        "n": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
        },
        "s": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000000"
        },
        "j": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() * 86400000 <= now + 50400000 && (!data.exists() || newData.val() >= data.val())"
        },
        "m": {
          ".validate": "newData.isNumber() && newData.val() >= newData.parent().child('s').val() && (!data.exists() || newData.val() >= data.val())"
        },
        "d": {
          ".validate": "newData.val() == now"
        },
        "$autre": {
          ".validate": false
        }
      }
    },
    "roulette": {
      ".read": true,
      ".indexOn": [
        "s"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren(['n', 's', 'j', 'm', 'd'])",
        "n": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
        },
        "s": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000000"
        },
        "j": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() * 86400000 <= now + 50400000 && (!data.exists() || newData.val() >= data.val())"
        },
        "m": {
          ".validate": "newData.isNumber() && newData.val() >= newData.parent().child('s').val() && (!data.exists() || newData.val() >= data.val())"
        },
        "d": {
          ".validate": "newData.val() == now"
        },
        "$autre": {
          ".validate": false
        }
      }
    },
    "rouletteLive": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren(['n', 'r', 'd'])",
        "n": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
        },
        "a": {
          ".validate": "newData.isString() && newData.val().length <= 8"
        },
        "r": {
          ".validate": "newData.isNumber()"
        },
        "m": {
          "$cle": {
            ".validate": "$cle.matches(/^(n([0-9]|[12][0-9]|3[0-6])|d[1-3]|c[1-3]|manque|passe|pair|impair|rouge|noir)$/) && newData.isNumber() && newData.val() > 0 && newData.val() <= 1000000000000"
          }
        },
        "d": {
          ".validate": "newData.val() == now"
        },
        "$autre": {
          ".validate": false
        }
      }
    },
    "resultats": {
      "$jeu": {
        ".read": "$jeu.matches(/^(wordle|loldle|paysdle|connexions|onepiecedle|pokedle|anidle|sudoku)$/)",
        ".indexOn": [
          "j"
        ],
        "$id": {
          ".write": "$jeu.matches(/^(wordle|loldle|paysdle|connexions|onepiecedle|pokedle|anidle|sudoku)$/) && $id.matches(/^[a-z0-9]{20}$/) && newData.exists() && (!data.exists() || newData.child('j').val() > data.child('j').val())",
          ".validate": "newData.hasChildren(['j', 'e', 'g', 'd'])",
          "j": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && now >= 1793491200000 + newData.val() * 86400000 - 10800000 && now <= 1793491200000 + (newData.val() + 1) * 86400000"
          },
          "e": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500"
          },
          "g": {
            ".validate": "newData.isBoolean()"
          },
          "d": {
            ".validate": "newData.val() == now"
          },
          "$autre": {
            ".validate": false
          }
        }
      }
    },
    "cdf_jour": {
      "$j": {
        "$mode": {
          ".read": "$j.matches(/^[0-9]{1,5}$/) && $mode.matches(/^(premier|meilleur)$/)",
          ".indexOn": [
            "k"
          ],
          "$id": {
            ".write": "$j.matches(/^[0-9]{1,5}$/) && $mode.matches(/^(premier|meilleur)$/) && $id.matches(/^[a-z0-9]{20}$/) && newData.exists() && ($mode === 'premier' ? !data.exists() : (!data.exists() || newData.child('k').val() > data.child('k').val()))",
            ".validate": "newData.hasChildren(['n', 's', 'lv', 'k', 'd'])",
            "n": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
            },
            "s": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 1000000000000000"
            },
            "lv": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999"
            },
            "k": {
              ".validate": "newData.isNumber() && newData.val() >= newData.parent().child('lv').val() * 1000000000 && newData.val() < (newData.parent().child('lv').val() + 1) * 1000000000"
            },
            "d": {
              ".validate": "newData.val() == now"
            },
            "$autre": {
              ".validate": false
            }
          }
        }
      }
    },
    "shikaku": {
      "$tab": {
        ".read": "$tab.matches(/^(j[0-9]{1,6}|s[0-9]{1,6}|m[0-9]{6}|l(5|7|9|11|15|20|25))$/)",
        ".indexOn": [
          "t"
        ],
        "$id": {
          ".write": "$tab.matches(/^(j[0-9]{1,6}|s[0-9]{1,6}|m[0-9]{6}|l(5|7|9|11|15|20|25))$/) && $id.matches(/^[a-z0-9]{20}$/) && newData.exists() && (!data.exists() || newData.child('t').val() < data.child('t').val())",
          ".validate": "newData.hasChildren(['n', 't', 'd'])",
          "n": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
          },
          "t": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 2592000"
          },
          "d": {
            ".validate": "newData.val() == now"
          },
          "$autre": {
            ".validate": false
          }
        }
      }
    },
    "admins": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && $uid !== auth.uid",
        ".validate": "newData.isBoolean() && newData.val() === true"
      }
    },
    "acces_ia": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.isBoolean() && newData.val() === true"
      }
    },
    "comptes": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['pseudo', 'cree'])",
        "pseudo": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 16"
        },
        "cree": {
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
        },
        "$autre": {
          ".validate": false
        }
      }
    },
    "pseudos": {
      "$cle": {
        ".read": true,
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))",
        ".validate": "newData.isString() && $cle.matches(/^[a-z0-9_-]{2,16}$/)"
      }
    },
    "reglages": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "annonce": {
        ".validate": "newData.hasChildren(['texte', 'actif'])",
        "texte": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "actif": {
          ".validate": "newData.isBoolean()"
        },
        "$autre": {
          ".validate": false
        }
      },
      "jeux": {
        "$slug": {
          ".validate": "$slug.matches(/^[a-z0-9-]{1,40}$/) && newData.hasChildren(['etat'])",
          "etat": {
            ".validate": "newData.isString() && newData.val().matches(/^(dispo|bientot|cache)$/)"
          },
          "badge": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "$autre": {
            ".validate": false
          }
        }
      },
      "ordre": {
        "$i": {
          ".validate": "$i.matches(/^[0-9]{1,3}$/) && newData.isString() && newData.val().matches(/^[a-z0-9-]{1,40}$/)"
        }
      },
      "$autre": {
        ".validate": false
      }
    },
    "defense_sauvegardes": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['json', 't'])",
        "json": {
          ".validate": "newData.isString() && newData.val().length <= 200000"
        },
        "t": {
          ".validate": "newData.isNumber()"
        },
        "$autre": {
          ".validate": false
        }
      }
    },
    "profils": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['pseudo', 'vu'])",
        "pseudo": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
        },
        "avatar": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "vu": {
          ".validate": "newData.val() == now"
        },
        "ou": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "groupe": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{20}$/)"
        },
        "$autre": {
          ".validate": false
        }
      }
    },
    "amis": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$ami": {
          ".write": "auth != null && ((!newData.exists() && (auth.uid === $uid || auth.uid === $ami)) || (newData.exists() && ((auth.uid === $uid && root.child('demandes').child($uid).child($ami).exists()) || (auth.uid === $ami && root.child('demandes').child($ami).child($uid).exists()))))",
          ".validate": "newData.val() === true"
        }
      }
    },
    "demandes": {
      "$dest": {
        ".read": "auth != null && auth.uid === $dest",
        "$src": {
          ".write": "auth != null && ((newData.exists() && auth.uid === $src && $src !== $dest && !root.child('amis').child($src).child($dest).exists()) || (!newData.exists() && (auth.uid === $dest || auth.uid === $src)))",
          ".validate": "newData.hasChildren(['pseudo', 'd'])",
          "pseudo": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
          },
          "d": {
            ".validate": "newData.val() == now"
          },
          "$autre": {
            ".validate": false
          }
        }
      }
    },
    "groupes": {
      "$gid": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && $gid.matches(/^[a-z0-9]{20}$/) && newData.child('chef').val() === auth.uid && newData.child('membres').child(auth.uid).exists()) || (data.exists() && !newData.exists() && data.child('chef').val() === auth.uid))",
        "chef": {
          ".write": "auth != null && data.exists() && (data.val() === auth.uid || !data.parent().child('membres').child(data.val()).exists()) && root.child('groupes').child($gid).child('membres').child(auth.uid).exists()",
          ".validate": "newData.isString() && newData.parent().child('membres').child(newData.val()).exists()"
        },
        "cree": {
          ".validate": "newData.isNumber()"
        },
        "membres": {
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid && (data.exists() || !newData.exists() || root.child('invitations').child($uid).child($gid).exists())) || (!newData.exists() && root.child('groupes').child($gid).child('chef').val() === auth.uid))",
            ".validate": "newData.hasChildren(['pseudo'])",
            "pseudo": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
            },
            "avatar": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "vu": {
              ".validate": "newData.val() == now"
            },
            "ou": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "$autre": {
              ".validate": false
            }
          }
        },
        "jeu": {
          ".write": "auth != null && root.child('groupes').child($gid).child('membres').child(auth.uid).exists()",
          ".validate": "newData.hasChildren(['slug', 'code', 'par', 'pseudo', 'd'])",
          "slug": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_-]{1,40}$/)"
          },
          "code": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{0,8}$/)"
          },
          "par": {
            ".validate": "newData.val() === auth.uid"
          },
          "pseudo": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
          },
          "d": {
            ".validate": "newData.val() == now"
          },
          "$autre": {
            ".validate": false
          }
        },
        "$autre": {
          ".validate": false
        }
      }
    },
    "invitations": {
      "$dest": {
        ".read": "auth != null && auth.uid === $dest",
        "$gid": {
          ".write": "auth != null && ((newData.exists() && root.child('groupes').child($gid).child('membres').child(auth.uid).exists() && root.child('amis').child(auth.uid).child($dest).exists()) || (!newData.exists() && (auth.uid === $dest || root.child('groupes').child($gid).child('membres').child(auth.uid).exists())))",
          ".validate": "newData.hasChildren(['de', 'pseudo', 'd'])",
          "de": {
            ".validate": "newData.val() === auth.uid"
          },
          "pseudo": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
          },
          "d": {
            ".validate": "newData.val() == now"
          },
          "$autre": {
            ".validate": false
          }
        }
      }
    }
  }
}
