{
  "rules": {
    "scores": {
      "$jeu": {
        ".read": "$jeu.matches(/^(blocs|labyrinthe|demineur_facile|demineur_moyen|demineur_expert)$/)",
        ".indexOn": ["s", "t"],
        "$id": {
          ".write": "$jeu.matches(/^(blocs|labyrinthe|demineur_facile|demineur_moyen|demineur_expert)$/) && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['n', 'd']) && ($jeu.beginsWith('demineur_') ? newData.hasChildren(['t']) : newData.hasChildren(['s', 'lv']))",
          "n": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16" },
          "d": { ".validate": "newData.val() == now" },
          "s": { ".validate": "!$jeu.beginsWith('demineur_') && newData.isNumber() && newData.val() > 0 && newData.val() <= 10000000" },
          "lv": { ".validate": "!$jeu.beginsWith('demineur_') && newData.isNumber() && newData.val() >= 1 && newData.val() <= 999" },
          "t": { ".validate": "$jeu.beginsWith('demineur_') && newData.isNumber() && newData.val() >= 1000 && newData.val() <= 3600000" },
          "$autre": { ".validate": false }
        }
      }
    }
  }
}
